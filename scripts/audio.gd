extends Node
## Autoload "Audio": music, fire ambience and sound effects.
## Music follows the game on its own (tavern / forest / graveyard); sound effects are played with Audio.play("coin").
## Every button in the game clicks softly by itself (see _on_node_added).
## Sounds are generated by tools/gen_music.py and tools/gen_sfx.py (8-bit style, like the pixel art).

const MUSIC_DIR := "res://assets/audio/music/"
const SFX_DIR := "res://assets/audio/sfx/"
const SETTINGS_PATH := "user://settings.cfg"
## Music for each place: "tavern" or a location id.
const MUSIC := {"tavern": "tavern", "forest": "forest", "graveyard": "graveyard"}
## Loudness of each sound effect in dB (0 = as generated). Missing = 0.
const SFX_DB := {
	"click": -9.0, "open": -8.0, "close": -9.0, "page": -6.0, "gather": -4.0, "visitor": -6.0,
	"bell": -3.0, "coin": -3.0, "buy": -4.0, "door": -3.0, "shelf": -5.0,
}
## Sounds that get a slightly random pitch every time, so repeats do not sound mechanical.
const SFX_VARY := ["click", "shelf", "gather", "coin", "dig", "brawl", "visitor"]
const MUSIC_DB := -9.0
const FIRE_DB := -12.0
const FADE_TIME := 1.2
const SFX_VOICES := 8

## 0..1, saved between games.
var music_volume: float = 0.7
var sfx_volume: float = 0.8

var _streams: Dictionary = {}
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
## The music player that plays (or fades in) the current track; the other one fades out.
var _active: AudioStreamPlayer
var _fire: AudioStreamPlayer
var _voices: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _current_music: String = ""
var _fade: Tween
var _game_over_played: bool = false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_load_settings()
	_music_a = _make_player()
	_music_b = _make_player()
	_active = _music_a
	_fire = _make_player()
	var fire_stream := _stream(MUSIC_DIR + "fire.ogg")
	if fire_stream != null:
		_fire.stream = fire_stream
	for i in SFX_VOICES:
		_voices.append(_make_player())
	get_tree().node_added.connect(_on_node_added)
	if has_node("/root/GameState"):
		GameState.changed.connect(_follow_game)
	_apply_volumes()


# ---------- Sound effects ----------

## Plays a sound effect by name (file assets/audio/sfx/<name>.wav). delay in seconds.
func play(sfx_name: String, delay: float = 0.0) -> void:
	if delay > 0.0:
		get_tree().create_timer(delay).timeout.connect(play.bind(sfx_name))
		return
	if sfx_volume <= 0.0:
		return
	var stream := _stream(SFX_DIR + sfx_name + ".wav")
	if stream == null:
		return
	var p := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % _voices.size()
	p.stream = stream
	p.volume_db = SFX_DB.get(sfx_name, 0.0) + linear_to_db(sfx_volume)
	p.pitch_scale = randf_range(0.94, 1.06) if sfx_name in SFX_VARY else 1.0
	p.play()


func _on_node_added(node: Node) -> void:
	if node is BaseButton and not node.has_meta("silent"):
		(node as BaseButton).pressed.connect(_on_button_pressed)


func _on_button_pressed() -> void:
	play("click")


# ---------- Music ----------

## Picks the music for where the keeper is now; called on every GameState change.
func _follow_game() -> void:
	if GameState.phase == GameState.Phase.GAME_OVER:
		if not _game_over_played:
			_game_over_played = true
			play("victory" if GameState.won else "defeat", 0.3)
			set_music("")
			_set_fire(false)
		return
	_game_over_played = false
	var place: String = GameState.trip.get("location", "tavern") if not GameState.trip.is_empty() else "tavern"
	set_music(MUSIC.get(place, "tavern"))
	_set_fire(place == "tavern")


## Crossfades to a track ("" = silence). The same track keeps playing from where it is.
func set_music(track: String) -> void:
	if track == _current_music:
		return
	_current_music = track
	if _fade != null and _fade.is_valid():
		_fade.kill()
	var old := _active
	_active = _music_b if old == _music_a else _music_a
	_active.stop()
	_fade = create_tween().set_parallel(true)
	if old.playing:
		_fade.tween_property(old, "volume_db", -60.0, FADE_TIME)
	var stream := _stream(MUSIC_DIR + track + ".ogg") if track != "" else null
	if stream != null:
		_active.stream = stream
		_active.volume_db = -60.0
		_active.play()
		_fade.tween_property(_active, "volume_db", _music_db(), FADE_TIME)
	_fade.chain().tween_callback(old.stop)


func _set_fire(on: bool) -> void:
	if _fire.stream == null:
		return
	if on and not _fire.playing:
		_fire.play()
	elif not on and _fire.playing:
		_fire.stop()


# ---------- Volume ----------

func set_music_volume(v: float) -> void:
	music_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func set_sfx_volume(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_save_settings()


func _music_db() -> float:
	return MUSIC_DB + linear_to_db(music_volume) if music_volume > 0.0 else -80.0


func _apply_volumes() -> void:
	if _fade != null and _fade.is_valid():
		_fade.kill()
		_inactive().stop()
	if _active.playing:
		_active.volume_db = _music_db()
	_fire.volume_db = FIRE_DB + linear_to_db(music_volume) if music_volume > 0.0 else -80.0


## Two sliders (music, sounds) for a settings popup.
func make_volume_panel() -> Control:
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 10)
	box.custom_minimum_size = Vector2(260, 0)
	for row in [["Музика", music_volume, set_music_volume], ["Звуки", sfx_volume, set_sfx_volume]]:
		var line := HBoxContainer.new()
		line.add_theme_constant_override("separation", 12)
		var label := Label.new()
		label.text = row[0]
		label.custom_minimum_size = Vector2(70, 0)
		line.add_child(label)
		var slider := HSlider.new()
		slider.min_value = 0.0
		slider.max_value = 1.0
		slider.step = 0.05
		slider.value = row[1]
		slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		slider.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		slider.value_changed.connect(row[2])
		if row[0] == "Звуки":
			slider.drag_ended.connect(func(_changed: bool) -> void: play("coin"))
		line.add_child(slider)
		box.add_child(line)
	return box


func _load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) == OK:
		music_volume = clampf(float(cfg.get_value("audio", "music", music_volume)), 0.0, 1.0)
		sfx_volume = clampf(float(cfg.get_value("audio", "sfx", sfx_volume)), 0.0, 1.0)


func _save_settings() -> void:
	var cfg := ConfigFile.new()
	cfg.load(SETTINGS_PATH)
	cfg.set_value("audio", "music", music_volume)
	cfg.set_value("audio", "sfx", sfx_volume)
	cfg.save(SETTINGS_PATH)


# ---------- Helpers ----------

func _inactive() -> AudioStreamPlayer:
	return _music_b if _active == _music_a else _music_a


func _make_player() -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	add_child(p)
	return p


func _stream(path: String) -> AudioStream:
	if _streams.has(path):
		return _streams[path]
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	_streams[path] = s
	return s
