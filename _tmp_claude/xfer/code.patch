+rect(FX0 - 4, MANTLE, FX1 + 4, MANTLE + 5, "5a3a22")
+hline(FX0 - 4, FX1 + 4, MANTLE, "7a5232"); hline(FX0 - 4, FX1 + 4, MANTLE + 4, "22150b")
+for cx in (FX0 + 2, FX1 - 4):
