+if FIRE_T is not None:
+    A = 2 * np.pi * FIRE_T
+    frng = random.Random(1234)
+    ph = [frng.uniform(0, 6.28) for _ in range(64)]
+    for col, hgt in [("8a2a1a", 20), ("e0582a", 15), ("ff9a3c", 11), ("ffd36b", 6), ("fff3c0", 3)]:
+        for fx in range(OX0 + 7, OX1 - 7):
