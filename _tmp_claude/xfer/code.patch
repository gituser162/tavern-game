+        if rng.random() < 0.25:
+            kx = x + rng.randrange(4, max(5, w - 4))
+            px(kx, y + 3, "2f1c11"); px(kx + 1, y + 3, "3a2214")
+        x += w
+    hline(0, W, y + h - 1, WOOD_SEAM)
+    y += h
+    row += 1
+rect(0, RAIL, W, RAIL + 3, BEAM); hline(0, W, RAIL, BEAM_HI); hline(0, W, RAIL + 2, BEAM_LO)
+
+# ---------- stone wainscot ----------
+y, row = RAIL + 3, 0
+while y < FLOOR_Y:
+    h = 5 if row % 2 == 0 else 6
+    x = -(row % 2) * 9
