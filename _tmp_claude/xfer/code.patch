+def slot_positions(place):
+    x0, x1, n, _ = SHELF_PLACES[place]
+    pitch = (x1 - x0) / n
+    out_ = []
+    for base in (SHELF_BASE, FLOOR_BASE):
+        for i in range(n):
+            out_.append((int(round(x0 + pitch * (i + 0.5))), base))
+    return out_
+
+
+def bake(fn, cx, b):
+    L = Layer()
+    fn(L, cx, b)
+    L.outline()
+    ys, xs = np.nonzero(L.a)
+    y0, y1, x0, x1 = ys.min(), ys.max() + 1, xs.min(), xs.max() + 1
+    lit = np.clip(L.rgb[y0:y1, x0:x1] * MULT[y0:y1, x0:x1], 0, 255).astype(np.uint8)
+    alpha = (L.a[y0:y1, x0:x1] * 255).astype(np.uint8)
+    return np.dstack([lit, alpha]), (int(x0), int(y0))
