+    (38, 122, 40, 0.28), (114, 122, 40, 0.28), (190, 122, 40, 0.28), (262, 122, 40, 0.28),
+    (38, 160, 36, 0.18), (114, 160, 36, 0.18), (190, 160, 36, 0.18), (262, 160, 36, 0.18),
