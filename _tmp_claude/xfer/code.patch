+"""Stock on the shelves under the counter (run from gen_bg6.py, which defines the palette, the light and MULT).
+Every storage compartment has slots; every item that can stand in a slot gets its own sprite, lit with the very
+same light as the background at that spot (so a bottle on the left looks just like the painted shelf behind it).
+Output (env SHELF_OUT = folder of the Godot project):
+  assets/objects/shelf_items.png  - atlas with all baked sprites
+  scripts/shelf_layout.gd         - SLOTS {place: [Vector2i]} and SPRITES {"place/slot/item": [atlas Rect2i, bg pos Vector2i]}
+"""
+import os
+
+SHELF_BASE = SHELF - 1      # objects on the middle shelf stand on this row
+FLOOR_BASE = UY1 - 5        # objects on the floor plank
+# place id: (x0, x1, pieces per row, item ids). Two rows each: shelf, then floor. 2 * per_row = capacity.
+SHELF_PLACES = {
+    "cellar": (3, 74, 6, ["ale", "mead", "wine"]),
+    "pantry": (78, 150, 6, ["bread", "chicken", "stew"]),
+    "chest": (154, 226, 3, ["shield", "chainmail", "axe", "fire_scroll", "moon_amulet", "sapphire_ring"]),
+    "cabinet": (230, 296, 4, ["heal_potion", "antidote", "strength_potion"]),
+}
+
+
+class Layer:
+    def __init__(self):
+        self.rgb = np.zeros((H, W, 3), np.float32)
+        self.a = np.zeros((H, W), bool)
+
+    def px(self, x, y, c):
+        if 0 <= x < W and 0 <= y < H:
+            self.rgb[y, x] = hx(c)
+            self.a[y, x] = True
+
+    def rect(self, x0, y0, x1, y1, c):
+        for yy in range(y0, y1):
+            for xx in range(x0, x1):
+                self.px(xx, yy, c)
+
+    def h(self, x0, x1, y, c):
+        self.rect(x0, y, x1, y + 1, c)
+
+    def v(self, x, y0, y1, c):
+        self.rect(x, y0, x + 1, y1, c)
+
+    def disc(self, cx, cy, r, c):
+        for yy in range(-r, r + 1):
+            for xx in range(-r, r + 1):
+                if xx * xx + yy * yy <= r * r + r * 0.6:
+                    self.px(cx + xx, cy + yy, c)
+
+    def outline(self):
+        """Dark 1px outline around everything drawn (like the painted props)."""
+        a = self.a.copy()
+        edge = np.zeros_like(a)
+        edge[1:, :] |= a[:-1, :]; edge[:-1, :] |= a[1:, :]; edge[:, 1:] |= a[:, :-1]; edge[:, :-1] |= a[:, 1:]
+        edge &= ~a
+        self.rgb[edge] = hx(OUT)
+        self.a |= edge
+
+
+# ---------- sprites: f(L, cx, b) draws the item centred on cx, standing on row b ----------
+
+def s_ale(L, cx, b):          # small barrel of ale with iron hoops and a tap
+    x0 = cx - 4
+    for yy in range(b - 10, b + 1):
+        bulge = 1 if b - 8 <= yy <= b - 2 else 0
+        L.h(x0 - bulge, x0 + 9 + bulge, yy, "6a4426")
+        L.px(x0 - bulge, yy, "8a6038"); L.px(x0 + 8 + bulge, yy, "4a2e1c")
+    for xx in (x0 + 2, x0 + 5):
+        L.v(xx, b - 9, b, "5a3820")
+    for yy in (b - 8, b - 2):
+        L.h(x0 - 1, x0 + 10, yy, "55555c")
+    L.h(x0, x0 + 9, b - 10, "8a6038")
+    L.px(cx, b - 5, BRASS); L.px(cx, b - 4, BRASS_HI)
+
+
+def s_mead(L, cx, b):         # drinking horn of mead on a little wooden stand
+    L.rect(cx - 4, b - 1, cx + 5, b + 1, "5a3a22"); L.h(cx - 4, cx + 5, b - 1, "7a5232")
+    L.v(cx - 3, b - 4, b - 1, "5a3a22"); L.v(cx + 3, b - 4, b - 1, "5a3a22")
+    horn = [(-4, 12), (-3, 11), (-2, 10), (-1, 9), (0, 8), (1, 7), (2, 6), (3, 6), (4, 7)]
+    for i, (dx, top) in enumerate(horn):
+        h_ = max(1, 4 - i // 2)
+        L.v(cx + dx, b - top, b - top + h_ + 1, "d8c8a0" if i < 6 else "8a6a42")
+    L.h(cx - 4, cx - 1, b - 12, BRASS)
+    L.px(cx - 3, b - 13, "e0a030"); L.px(cx - 2, b - 13, "f0c050")   # honey at the rim
+
+
+def s_wine(L, cx, b):         # slim bottle of elven wine with a green label
+    L.rect(cx - 2, b - 11, cx + 3, b + 1, "5a1e3a")
+    L.v(cx - 1, b - 10, b - 1, "8a3a5a")
+    L.rect(cx - 1, b - 15, cx + 2, b - 11, "4a1830")
+    L.rect(cx - 1, b - 17, cx + 2, b - 15, "c8a868")
+    L.rect(cx - 2, b - 7, cx + 3, b - 4, "4a8a5a"); L.px(cx, b - 6, BRASS_HI)
+
+
+def s_bread(L, cx, b):        # rye loaf
+    for yy in range(b - 5, b + 1):
+        half = [3, 4, 5, 5, 5, 5][yy - (b - 5)]
+        L.h(cx - half, cx + half + 1, yy, "8a5a2e")
+        L.px(cx + half, yy, "5a3a1a")
+    L.h(cx - 2, cx + 3, b - 5, "a87440")
+    for k in (-2, 1, 4):
+        L.px(cx + k - 1, b - 3, "5a3a1a"); L.px(cx + k, b - 4, "5a3a1a")
+
+
+def s_chicken(L, cx, b):      # roast chicken on a plate
+    L.h(cx - 5, cx + 6, b, "b8b0a0"); L.h(cx - 4, cx + 5, b - 1, "d8d0c0")
+    for yy in range(b - 6, b - 1):
+        half = [3, 4, 4, 4, 3][yy - (b - 6)]
+        L.h(cx - half, cx + half + 1, yy, "c07a32")
+        L.px(cx - half, yy, "e0a050")
+    L.h(cx - 2, cx + 2, b - 6, "e0a050")
+    L.px(cx + 4, b - 7, "c07a32"); L.px(cx + 5, b - 8, "e8e0d0"); L.px(cx + 6, b - 8, "e8e0d0")   # drumstick
+    L.px(cx - 4, b - 7, "c07a32"); L.px(cx - 5, b - 8, "e8e0d0")
+
+
+def s_stew(L, cx, b):         # iron pot of venison stew
+    for yy in range(b - 6, b + 1):
+        half = [5, 5, 5, 5, 4, 4, 3][yy - (b - 6)]
+        L.h(cx - half, cx + half + 1, yy, "3a3a42")
+        L.px(cx - half + 1, yy, "5a5a64")
+    L.h(cx - 5, cx + 6, b - 7, "4a4a52")
+    L.h(cx - 4, cx + 5, b - 7, "7a3e22"); L.px(cx - 1, b - 7, "a85a2a"); L.px(cx + 2, b - 7, "6a8a3a")
+    L.px(cx - 6, b - 5, "3a3a42"); L.px(cx + 6, b - 5, "3a3a42")      # ears
+    L.px(cx - 1, b - 9, "6a5a50"); L.px(cx + 1, b - 10, "6a5a50")      # steam
+
+
+def s_heal(L, cx, b):         # round red flask
+    L.disc(cx, b - 4, 4, "a82a2a")
+    L.px(cx - 2, b - 6, "e87060"); L.px(cx - 2, b - 5, "c84a40")
+    L.rect(cx - 1, b - 11, cx + 2, b - 8, "8a9a9a")
+    L.rect(cx - 1, b - 13, cx + 2, b - 11, "8a6a42")
+
+
+def s_antidote(L, cx, b):     # tall green vial
+    L.rect(cx - 2, b - 10, cx + 3, b + 1, "3a8a3a")
+    L.v(cx - 1, b - 9, b - 1, "7ac86a")
+    L.h(cx - 2, cx + 3, b - 10, "8a9a9a")
+    L.rect(cx - 1, b - 13, cx + 2, b - 10, "9aaaaa")
+    L.rect(cx - 1, b - 15, cx + 2, b - 13, "8a6a42")
+
+
+def s_strength(L, cx, b):     # square orange bottle with a bull label
+    L.rect(cx - 3, b - 8, cx + 4, b + 1, "c8702a")
+    L.v(cx - 2, b - 7, b - 1, "f0a050")
+    L.rect(cx - 1, b - 11, cx + 2, b - 8, "8a9a9a")
+    L.rect(cx - 1, b - 13, cx + 2, b - 11, "8a6a42")
+    L.rect(cx - 1, b - 5, cx + 2, b - 2, "e8dcc0"); L.px(cx, b - 4, "5a1e1e")
+
+
+def s_shield(L, cx, b):       # round oak shield standing on its edge
+    r = 8
+    cy = b - r
+    for yy in range(-r, r + 1):
+        for xx in range(-r, r + 1):
+            d2 = xx * xx + yy * yy
+            if d2 <= r * r + 3:
+                c = "8a5a2e" if (xx + 7) // 3 % 2 == 0 else "7a4e26"
+                if d2 >= (r - 1) ** 2:
+                    c = "55555c"
+                L.px(cx + xx, cy + yy, c)
+    L.disc(cx, cy, 2, "8a8e96"); L.px(cx - 1, cy - 1, "c8ccd4")
+
+
+def s_chainmail(L, cx, b):    # chainmail shirt on a wooden stand
+    L.v(cx, b - 3, b + 1, "5a3a22"); L.h(cx - 3, cx + 4, b, "5a3a22")
+    L.h(cx - 6, cx + 7, b - 14, "5a3a22")
+    for yy in range(b - 13, b - 2):
+        half = 6 if yy < b - 9 else 4
+        for xx in range(cx - half, cx + half + 1):
+            L.px(xx, yy, "9a9ea6" if (xx + yy) % 2 == 0 else "6a6e76")
+    L.h(cx - 2, cx + 3, b - 13, "3a3a42")
+    L.h(cx - 4, cx + 5, b - 3, "8a6a42")
+
+
+def s_axe(L, cx, b):          # battle axe leaning upright
+    L.v(cx, b - 17, b + 1, "6a4426"); L.v(cx + 1, b - 17, b + 1, "8a6038")
+    for yy in range(b - 17, b - 9):
