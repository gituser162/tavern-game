+# ---------- Stock on the shelves ----------
+## Every piece in a storage stands in its own slot on the shelf (or on the floor plank) of its compartment.
+## A bought piece drops onto its slot with a knock; a sold one fades away and leaves the slot empty.
+## Pieces keep their slots: new ones go to a free slot next to the same item, so the shelves look like a real store.
+
+func _build_shelves() -> void:
+	_shelf_atlas = load(ShelfLayout.ATLAS) if ResourceLoader.exists(ShelfLayout.ATLAS) else null
+	for place_id in ShelfLayout.SLOTS:
+		var nodes: Array = []
+		var items: Array = []
+		for i in ShelfLayout.SLOTS[place_id].size():
+			var t := TextureRect.new()
+			t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+			t.stretch_mode = TextureRect.STRETCH_SCALE
+			t.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
+			t.mouse_filter = Control.MOUSE_FILTER_IGNORE
+			t.visible = false
+			var atlas := AtlasTexture.new()
+			atlas.atlas = _shelf_atlas
+			t.texture = atlas
+			# Child of the storage object: it lights up with it on hover and lets clicks through.
+			_storage_objects[place_id]["button"].add_child(t)
+			nodes.append(t)
+			items.append("")
+		_shelf_nodes[place_id] = nodes
+		_shelf_items[place_id] = items
+
+
+## True while a big window or a location covers the shelves (pieces are put on them once the room is back in view).
+func _shelves_covered() -> bool:
+	return _market_window.visible or _alchemy_window.visible or _location_view.visible
+
+
+## Which item each slot should show: pieces that are still in storage keep their slots, missing ones leave
+## (from the end), new ones take the free slot closest to their kind (or the first free slot).
+func _shelf_plan(place_id: String) -> Array:
+	var plan: Array = _shelf_items[place_id].duplicate()
+	var st := GameState.storage
+	var shown := {}
+	for id in plan:
+		if id != "":
+			shown[id] = shown.get(id, 0) + 1
+	for i in range(plan.size() - 1, -1, -1):
+		var id: String = plan[i]
+		if id != "" and shown[id] > st.count(id):
+			shown[id] -= 1
+			plan[i] = ""
+	for id in st.ids_in_place(place_id):
+		for n in st.count(id) - shown.get(id, 0):
+			var best := -1
+			var best_d := 1 << 20
+			for i in plan.size():
+				if plan[i] != "":
+					continue
+				var d := 1000 + i
+				for j in plan.size():
+					if plan[j] == id:
+						d = mini(d, absi(j - i))
+				if d < best_d:
+					best_d = d
+					best = i
+			if best < 0:
+				break  # more pieces than slots: the rest is not drawn
+			plan[best] = id
+	return plan
+
+
+func _update_shelves() -> void:
+	_shelves_dirty = false
+	var animate := _shelves_ready
+	_shelves_ready = true
+	var k := maxf(_bg.size.x / BG_SIZE.x, _bg.size.y / BG_SIZE.y)
+	var arrivals := 0
+	for place_id in _shelf_nodes:
+		var plan := _shelf_plan(place_id)
+		for i in plan.size():
+			var old_id: String = _shelf_items[place_id][i]
+			var new_id: String = plan[i]
+			if old_id == new_id:
+				continue
+			_shelf_items[place_id][i] = new_id
+			var t: TextureRect = _shelf_nodes[place_id][i]
+			if t.has_meta("tween"):
+				(t.get_meta("tween") as Tween).kill()
+				t.remove_meta("tween")
+			if new_id == "":
+				if animate and t.visible:
+					_shelf_leave(t, k)
+				else:
+					t.visible = false
+				continue
+			_place_shelf_slot(place_id, i)
+			t.visible = true
+			t.modulate = Color.WHITE
+			if animate:
+				_shelf_arrive(t, k, arrivals * 0.07)
+				arrivals += 1
+
+
+## A piece drops onto the shelf from a little above and bounces, with a knock of wood.
+func _shelf_arrive(t: TextureRect, k: float, delay: float) -> void:
+	var rest := t.position
+	t.position = rest - Vector2(0, 7.0 * k)
+	t.modulate.a = 0.0
+	var tw := create_tween()
+	tw.tween_interval(delay)
+	tw.tween_property(t, "modulate:a", 1.0, 0.08)
+	tw.parallel().tween_property(t, "position", rest, 0.38).set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)
+	tw.finished.connect(func() -> void: t.remove_meta("tween"))
+	t.set_meta("tween", tw)
+	if delay < 0.6:
+		Audio.play("shelf", delay + 0.12)
+
+
+## A sold piece rises a little and fades away.
+func _shelf_leave(t: TextureRect, k: float) -> void:
+	var rest := t.position
+	var tw := create_tween()
+	tw.tween_property(t, "position", rest - Vector2(0, 3.0 * k), 0.3)
+	tw.parallel().tween_property(t, "modulate:a", 0.0, 0.3)
+	tw.tween_callback(func() -> void:
+		t.visible = false
+		t.position = rest
+		t.modulate.a = 1.0
+		t.remove_meta("tween"))
+	t.set_meta("tween", tw)
+
+
+## Puts the sprite of slot i at its spot (sprites are children of the storage button, which covers STORAGE_RECTS).
+func _place_shelf_slot(place_id: String, i: int) -> void:
+	var t: TextureRect = _shelf_nodes[place_id][i]
+	var id: String = _shelf_items[place_id][i]
+	if id == "":
+		return
+	var key := "%s/%d/%s" % [place_id, i, id]
+	if not ShelfLayout.SPRITES.has(key):
+		t.visible = false
+		return
+	var entry: Array = ShelfLayout.SPRITES[key]
+	var region: Rect2i = entry[0]
+	(t.texture as AtlasTexture).region = Rect2(region)
+	var k := maxf(_bg.size.x / BG_SIZE.x, _bg.size.y / BG_SIZE.y)
+	t.position = Vector2(entry[1] - STORAGE_RECTS[place_id].position) * k
+	t.size = Vector2(region.size) * k
+
+
+func _place_shelves() -> void:
+	for place_id in _shelf_nodes:
+		for i in _shelf_nodes[place_id].size():
+			_place_shelf_slot(place_id, i)
+
